# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is listed in .gitignore. Never commit real credentials.

# Mugrade API key ("Show API Key" on the Mugrade course page).
# Only cells decorated with @mugrade.submit_tests need it.
MUGRADE_KEY=

# Hugging Face access token. Optional; it raises download rate limits for the
# course datasets and checkpoints (huggingface_hub reads HF_TOKEN).
HF_TOKEN=

# Weights & Biases API key. Optional; only training runs with log=True need it.
WANDB_API_KEY=
